# 本地开发用这个文件，复制为 .env 后填入真实值
# 生产环境用 AWS Secrets Manager，不用这个文件

# Flask
FLASK_ENV=development
SECRET_KEY=dev-secret-change-in-production

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRY_HOURS=168

# 数据库
# 本地开发：用 SQLite（默认）
# 生产环境：填入 RDS 连接字符串
DATABASE_URL=sqlite:///data/trainer.db
# DATABASE_URL=postgresql://user:password@host:5432/gto_trainer

# Redis
# 本地开发：用内存模拟（不填则降级到内存dict）
# 生产环境：填入 ElastiCache 连接字符串
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://your-elasticache-endpoint:6379/0

# 权益计算模拟次数（生产环境可以调高）
EQUITY_SIMULATIONS=800
